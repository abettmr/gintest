syntax = "v1"

info(
	title: "网盘系统-用户仓库模块"
	desc: "用户与仓库关联关系管理"
	version: "v1"
)

type (
    // 用户仓库基本信息
    UserRepoItem {
        Identity       string `json:"identity"`
        UserIdentity   string `json:"user_identity"`
        RepoIdentity   string `json:"repo_identity"`
        ParentId       int64  `json:"parent_id"`
        Ext            string `json:"ext"`
        CreatedAt      string `json:"created_at"`
    }
    
    // 用户仓库列表请求
    UserRepoListReq {
        ParentId int64 `form:"parent_id,optional"`
        Page     int   `form:"page,optional"`
        Size     int   `form:"size,optional"`
    }
    
    // 用户仓库列表响应
    UserRepoListResp {
        List  []UserRepoItem `json:"list"`
        Total int64          `json:"total"`
    }
    
    // 用户仓库创建请求
    UserRepoCreateReq {
        RepoIdentity string `json:"repo_identity"`
        ParentId     int64  `json:"parent_id,optional"`
        Ext          string `json:"ext,optional"`
    }
    
    // 用户仓库删除请求
    UserRepoDeleteReq {
        Identity string `json:"identity"`
    }
    
    // 用户仓库移动请求
    UserRepoMoveReq {
        Identity string `json:"identity"`
        ParentId int64  `json:"parent_id"`
    }
)

@server(
    prefix: /user-repo/v1
    group: userRepo
)
service userRepo {
    @handler list
    get /list (UserRepoListReq) returns (UserRepoListResp)
    
    @handler create
    post /create (UserRepoCreateReq) returns (Response)
    
    @handler delete
    post /delete (UserRepoDeleteReq) returns (Response)
    
    @handler move
    post /move (UserRepoMoveReq) returns (Response)
    
    @handler detail
    get /detail (Identity string `form:"identity") returns (UserRepoItem)
}