syntax = "v1"

info (
	title:   "网盘系统-用户模块"
	desc:    "用户相关接口"
	version: "v1"
)

import "../base.api"

type (
	UserBasicInfo {
		Identity string `json:"identity"`
		Name     string `json:"name"`
		Email    string `json:"email"`
	}
	LoginReq {
		Name     string `json:"name"`
		Password string `json:"password"`
	}
	LoginResp {
		Token string `json:"token"`
		UserBasicInfo
	}
	UserDetailResp {
		UserBasicInfo
		CreatedAt string `json:"created_at"`
	}
	RegisterReq {
		Name     string `json:"name"`
		Password string `json:"password"`
		Email    string `json:"email"`
	}
	ChangePasswordReq {
		OldPassword string `json:"old_password"`
		NewPassword string `json:"new_password"`
	}
    FileItem {
		Identity  string `json:"identity"`
		Name      string `json:"name"`
		Ext       string `json:"ext"`
		Size      int64  `json:"size"`
		Path      string `json:"path"`
		CreatedAt string `json:"created_at"`
	}
	FileListReq {
		ParentId int64 `form:"parent_id,optional"`
		Page     int   `form:"page,optional"`
		Size     int   `form:"size,optional"`
	}
	FileUploadReq {
		File     string `form:"file"`
		ParentId int64  `form:"parent_id,optional"`
	}
	FolderCreateReq {
		Name     string `json:"name"`
		ParentId int64  `json:"parent_id,optional"`
	}
	FileRenameReq {
		Identity string `json:"identity"`
		NewName  string `json:"new_name"`
	}
	FileMoveReq {
		Identity string `json:"identity"`
		ParentId int64  `json:"parent_id"`
	}

	// 用户仓库项
	UserRepoItem {
		Identity     string `json:"identity"`
		UserIdentity string `json:"user_identity"`
		RepoIdentity string `json:"repo_identity"`
		ParentId     int64  `json:"parent_id"`
		Ext          string `json:"ext"`
		CreatedAt    string `json:"created_at"`
		UpdatedAt    string `json:"updated_at"`
	}
	// 用户仓库详情
	UserRepoDetail {
		UserRepoItem
		Name string `json:"name"`
		Size int64  `json:"size"`
		Path string `json:"path"`
	}
	// 列表请求
	UserRepoListReq {
		ParentId int64 `form:"parent_id,optional"`
		Page     int   `form:"page,optional"`
		Size     int   `form:"size,optional"`
	}
	// 创建请求
	UserRepoCreateReq {
		RepoIdentity string `json:"repo_identity"`
		ParentId     int64  `json:"parent_id,optional"`
		Ext          string `json:"ext,optional"`
	}
	// 移动请求
	UserRepoMoveReq {
		Identity string `json:"identity"`
		ParentId int64  `json:"parent_id"`
	}
    
	// 分享基本信息
	ShareBasicInfo {
		Identity     string `json:"identity"`
		UserIdentity string `json:"user_identity"`
		RepoIdentity string `json:"repo_identity"`
		ExpireTime   int64  `json:"expire_time"` // Unix时间戳
		CreatedAt    string `json:"created_at"`
		UpdatedAt    string `json:"updated_at"`
	}
	// 分享详情信息
	ShareDetailInfo {
		ShareBasicInfo
		FileName    string `json:"file_name"`
		FileSize    int64  `json:"file_size"`
		FileExt     string `json:"file_ext"`
		DownloadNum int64  `json:"download_num"` // 下载次数
	}
	// 创建分享请求
	ShareCreateReq {
		RepoIdentity string `json:"repo_identity"`
		ExpireTime   int64  `json:"expire_time,optional"` // 秒数，0表示永久
		Password     string `json:"password,optional"` // 可选密码
	}
	// 分享验证请求
	ShareVerifyReq {
		Identity string `json:"identity"`
		Password string `json:"password,optional"` // 如果有密码保护
	}
	// 分享验证响应
	ShareVerifyResp {
		Valid        bool   `json:"valid"`
		FileName     string `json:"file_name"`
		FileSize     int64  `json:"file_size"`
		FileExt      string `json:"file_ext"`
		ExpireTime   int64  `json:"expire_time"`
		NeedPassword bool   `json:"need_password"`
	}
	// 分享列表项
	ShareListItem {
		ShareBasicInfo
		FileName  string `json:"file_name"`
		FileExt   string `json:"file_ext"`
		IsExpired bool   `json:"is_expired"`
	}
	// 分享统计信息
	ShareStats {
		TotalShares    int64 `json:"total_shares"`
		ActiveShares   int64 `json:"active_shares"`
		TotalDownloads int64 `json:"total_downloads"`
	}
	PopShareReq {
		Limit int `form:"limit,default=10"`
	}
)

@server (
	prefix:     /share/v1
	group:      share
	middleware: Auth // 需要认证的中间件
)
service share {
	// 创建分享
	@handler createShare
	post /create (ShareCreateReq) returns (DataResponse /*[ShareBasicInfo]*/)

	// 获取分享详情
	@handler getShareDetail
	get /detail (IdJsonReq) returns (DataResponse /*[ShareBasicInfo]*/)

	// 验证分享
	@handler verifyShare
	post /verify (ShareVerifyReq) returns (DataResponse /*[ShareVerifyResp]*/)

	// 下载分享文件
	@handler downloadShare
	get /download (IdJsonReq) returns (BaseResponse)

	// 获取我的分享列表
	@handler listMyShares
	get /my/list returns (PageResponse /*[ShareListItem]*/)

	// 获取分享统计
	@handler getShareStats
	get /stats returns (DataResponse /*[ShareStats]*/)

	// 更新分享设置
	@handler updateShare
	post /update (ShareBasicInfo) returns (BaseResponse)

	// 取消分享
	@handler cancelShare
	post /cancel (IdFormReq) returns (BaseResponse)

	// 获取热门分享
	@handler getPopularShares
	get /popular (PopShareReq) returns (DataResponse /*[[]ShareListItem]*/)
}

@server (
	prefix: /user-repo/v1
	group:  userRepo
)
service userRepo {
	@handler list
	get /list (UserRepoListReq) returns (PageResponse /*[UserRepoDetail]*/)

	@handler create
	post /create (UserRepoCreateReq) returns (DataResponse /*[UserRepoItem]*/)

	@handler detail
	get /detail (IdFormReq) returns (DataResponse /*[UserRepoDetail]*/)

	@handler move
	post /move (UserRepoMoveReq) returns (BaseResponse)

	@handler delete
	post /delete (IdJsonReq) returns (BaseResponse)
}

@server (
	prefix: /repo/v1
	group:  repository
)
service repository {
	@handler list
	get /list (FileListReq) returns (PageResponse /*[FileItem]*/)

	@handler upload
	post /upload (FileUploadReq) returns (BaseResponse)

	@handler download
	get /download (IdFormReq) returns (BaseResponse)

	@handler createFolder
	post /folder/create (FolderCreateReq) returns (BaseResponse)

	@handler rename
	post /rename (FileRenameReq) returns (BaseResponse)

	@handler move
	post /move (FileMoveReq) returns (BaseResponse)

	@handler delete
	post /delete (IdJsonReq) returns (BaseResponse)
}

@server (
	prefix: /user/v1
	group:  user
)
service user {
	@handler register
	post /register (RegisterReq) returns (DataResponse /*[LoginResp]*/)

	@handler login
	post /login (LoginReq) returns (DataResponse /*[LoginResp]*/)

	@handler detail
	get /detail returns (DataResponse /*[UserDetailResp]*/)

	@handler changePassword
	post /password/change (ChangePasswordReq) returns (BaseResponse)
}

